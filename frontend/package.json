             , "preview": "npm run build && vite preview"
             }

, "engines" : { "npm":  "~11.8.0"
              , "node": "~24.13.1"
              }

, "dependencies": { "vue":        "~3.3.0"
                  , "vue-router": "~4.2.0"
                  , "zod":        "~4.3.0"
                  }

, "devDependencies": { "@vitejs/plugin-vue":  "~6.0.6"
                     , "eslint-plugin-vue":  "~10.8.0"
                     , "typescript":          "~5.5.0"
                     , "typescript-eslint":  "~8.53.0"
                     , "vite":                "~8.0.9"
                     , "vue-eslint-parser":  "~10.4.0"
                     , "vue-tsc":             "~3.2.0"
                     }

}
