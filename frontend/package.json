                  , "vue-router": "~5.2.0"
                  , "zod":        "~4.4.3"
                  }

, "devDependencies": { "@vitejs/plugin-vue":  "~6.0.8"
                     , "eslint-plugin-vue":  "~10.10.0"
                     , "typescript":          "~6.0.3"
                     , "typescript-eslint":  "~8.66.0"
                     , "vite":                "~8.2.1"
                     , "vue-eslint-parser":  "~10.4.1"
                     , "vue-tsc":             "~3.3.9"
                     }

}
