                  , "vue-router": "~5.1.0"
                  , "zod":        "~4.4.3"
                  }

, "devDependencies": { "@vitejs/plugin-vue":  "~6.0.7"
                     , "eslint-plugin-vue":  "~10.9.2"
                     , "typescript":          "~6.0.3"
                     , "typescript-eslint":  "~8.62.0"
                     , "vite":                "~8.0.16"
                     , "vue-eslint-parser":  "~10.4.1"
                     , "vue-tsc":             "~3.3.5"
                     }

}
