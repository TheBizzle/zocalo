{

  "name":        "gallery-app-frontend"
, "version":     "1.0.0"
, "description": "Gallery app frontend"

, "scripts": { "dev":       "vite"
             , "ci-lint":   "npx eslint src"
             , "lint":      "vue-tsc --noEmit && npx eslint src"
             , "dev-build": "vite build"
             , "build":     "npm run lint && vite build"
             , "preview":   "npm run build && vite preview"
             , "test":      "vitest run"
             }

, "engines" : { "npm":  "~11.12.1"
              , "node": "~24.15.0"
              }

, "dependencies": { "dompurify":  "~3.4.16"
                  , "vue":        "~3.5.43"
                  , "vue-router": "~5.3.1"
                  , "zod":        "~4.6.5"
                  }

, "devDependencies": { "@types/node":          "26.6.5"
                     , "@vitejs/plugin-vue":   "~6.0.9"
                     , "eslint-plugin-vue":  "~10.11.1"
                     , "jsdom":               "~30.1.3"
                     , "typescript":           "~6.0.3"
                     , "typescript-eslint":   "~8.70.1"
                     , "vite":                 "~8.3.1"
                     , "vitest":               "~5.0.5"
                     , "vue-eslint-parser":   "~10.4.1"
                     , "vue-tsc":              "~3.3.11"
                     }

}
