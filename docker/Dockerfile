# syntax=docker/dockerfile:1

# NOTE: Initial file generated by Claude Sonnet 5.5.

# Build from the project root (the build context), pointing at this file. The
# env file is passed as a BuildKit secret, so it is not stored in an image
# layer; note that the compiled binary still contains its values:
#   docker build -f docker/Dockerfile \
#     --build-arg GIT_SHA="$(git rev-parse --short HEAD)" \
#     --secret id=zocalo_env,src=docker/zocalo.env -t zocalo .
#
# Optional: --build-arg NODE_VERSION=22 to build the frontend with another
# Node.js major version (default below).
#
# Files to ignore are listed in docker/Dockerfile.dockerignore (BuildKit reads
# "<Dockerfile name>.dockerignore" next to the Dockerfile).

ARG NODE_VERSION=24

# ---------------------------------------------------------------------------
# Stage 1: frontend (npm). Inputs: frontend/ only.
# ---------------------------------------------------------------------------
FROM node:${NODE_VERSION}-bookworm-slim AS frontend

WORKDIR /src/frontend

# Dependencies first: cached until package.json / the lockfile change.
COPY frontend/package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY frontend/ ./
RUN npm run build

# ---------------------------------------------------------------------------
# Stage 2: backend (Stack). Inputs: everything except frontend/ and docker/.
# ---------------------------------------------------------------------------
FROM haskell:9.10-bookworm AS backend

RUN apt-get update \
 && apt-get install -y --no-install-recommends libgmp-dev libpq-dev zlib1g-dev pkg-config \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Haskell dependencies: cached until the dependency definitions change.
COPY stack.yaml* package.yaml ./
RUN stack build --only-dependencies

# Application sources. frontend/ and docker/ are excluded so that changes there
# do not invalidate this layer. (COPY --exclude is applied before the cache key
# is computed.)
COPY --exclude=frontend --exclude=docker . .
COPY docker/generate-config.sh docker/load-env.sh docker/

# conf/actual.yaml is generated from the env file because Template Haskell reads
# it during compilation. The commit hash is written to git-sha.txt, which the
# gitSHA splice reads. ARG is declared here, right before its first use, so a new
# GIT_SHA only invalidates this step. The .stack-work cache mount keeps GHC's
# incremental state between builds, so that rebuild is incremental.
ARG GIT_SHA
RUN --mount=type=secret,id=zocalo_env \
    --mount=type=cache,target=/src/.stack-work \
    if [ -n "$GIT_SHA" ]; then printf '%s\n' "$GIT_SHA" > git-sha.txt; fi \
 && bash docker/generate-config.sh /run/secrets/zocalo_env conf/template.yaml conf/actual.yaml \
 && stack build \
 && mkdir -p /out \
 && stack install zocalo --local-bin-path /out

# ---------------------------------------------------------------------------
# Stage 3: runtime image (app + Postgres + CertBot + Caddy), Ubuntu 26.04
# ---------------------------------------------------------------------------
FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      caddy \
      certbot \
      libgmp10 \
      libpq5 \
      postgresql \
      zlib1g \
 && rm -rf /var/lib/apt/lists/* \
 && (systemctl disable caddy postgresql 2>/dev/null || true)

COPY --from=backend /out/run-zocalo /usr/local/bin/run-zocalo

WORKDIR /app
COPY . /app

# frontend/dist is excluded from the build context, so this is the only copy of
# it in the image.
COPY --from=frontend /src/frontend/dist /app/frontend/dist

COPY docker/load-env.sh /usr/local/bin/load-env.sh
COPY docker/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh \
 && mkdir -p /usr/local/pgsql/data /usr/local/pgsql/log /var/run/postgresql \
 && chown -R postgres:postgres /usr/local/pgsql /var/run/postgresql \
 && chmod 700 /usr/local/pgsql/data

# Persist the database and the issued certificates across container restarts
# (/root/.local/share/caddy holds Caddy's internal CA, used when DOMAIN=localhost)
VOLUME ["/usr/local/pgsql/data", "/etc/letsencrypt", "/root/.local/share/caddy"]

# 80: CertBot HTTP-01 challenge (standalone mode); 443: Caddy (HTTPS)
EXPOSE 80 443

# At run time, mount the same env file at /zocalo.env (override the path with
# ZOCALO_ENV_FILE). Variables set with -e take precedence over the file.
#
# Used at run time:
#   DOMAIN                 Required. Public domain name pointing at this host
#                          ("localhost" skips CertBot and uses Caddy's internal CA)
#   CERTBOT_EMAIL          Required unless DOMAIN=localhost
#   CERTBOT_STAGING=1      Optional. Use Let's Encrypt's staging environment
#   DB_NAME                Optional. Must match the value used at build time
#                          (default "zocalo")
# Used at build time only (see docker/generate-config.sh):
#   MAILTRAP_API_SECRET, SENDER_ADDRESS, SENDER_NAME, CRYPTOGRAPHY_SECRET,
#   DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
